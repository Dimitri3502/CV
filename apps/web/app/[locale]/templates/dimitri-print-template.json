{
  "version": 1,
  "id": "dimitri-print-template",
  "settings": {
    "themeColor": "#424F64"
  },
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": "8mm",
      "bottom": "8mm",
      "mainHorizontal": "14mm",
      "sidebarHorizontal": "10mm"
    }
  },
  "zones": {
    "firstPage.left": {
      "overflow": "drop-tail",
      "sections": [
        "photo",
        "contact",
        "expertise"
      ]
    },
    "firstPage.right": {
      "overflow": "drop-tail",
      "sections": [
        "header",
        "profile",
        "education"
      ]
    },
    "otherPages.main": {
      "overflow": "paginate",
      "sections": [
        "certifications",
        "experience"
      ]
    }
  }
}
