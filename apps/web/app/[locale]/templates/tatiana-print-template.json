{
  "version": 1,
  "id": "tatiana-print-template",
  "settings": {
    "themeColor": "#7b754c"
  },
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": "08mm",
      "bottom": "8mm",
      "mainHorizontal": "8mm",
      "sidebarHorizontal": "8mm"
    }
  },
  "zones": {
    "firstPage.left": {
      "overflow": "drop-tail",
      "sections": [
        "photo",
        "contact",
        "languages",
        "expertise"
      ]
    },
    "firstPage.right": {
      "overflow": "drop-tail",
      "sections": [
        "header",
        "profile",
        {
          "key": "certifications",
          "variant": "compact"
        }
      ]
    },
    "otherPages.main": {
      "overflow": "paginate",
      "sections": [
        "education",
        "experience",
        {
          "key": "publications",
          "variant": "compact"
        },
        {
          "key": "interventions",
          "variant": "compact"
        },
        {
          "key": "engagements",
          "variant": "compact"
        }
      ]
    }
  }
}
