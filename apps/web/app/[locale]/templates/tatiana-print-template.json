{
  "version": 1,
  "id": "tatiana-print-template",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": "08mm",
      "bottom": "8mm",
      "mainHorizontal": "14mm",
      "sidebarHorizontal": "10mm",
      "columnGap": "6mm"
    }
  },
  "zones": {
    "firstPage.left": {
      "overflow": "drop-tail",
      "sections": [
        "photo",
        "contact",
        "languages"
      ]
    },
    "firstPage.right": {
      "overflow": "drop-tail",
      "sections": [
        "header",
        "profile",
        "education"
      ]
    },
    "otherPages.main": {
      "overflow": "paginate",
      "sections": [
        "expertise",
        "certifications",
        "experience",
        "publications",
        "interventions",
        "engagements"
      ]
    }
  }
}
