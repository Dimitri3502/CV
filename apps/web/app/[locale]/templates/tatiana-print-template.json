{
  "version": 1,
  "id": "tatiana-print-template",
  "settings": {
    "themeColor": "#b5ac70"
  },
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": "08mm",
      "bottom": "8mm",
      "mainHorizontal": "8mm",
      "sidebarHorizontal": "8mm"
    }
  },
  "zones": {
    "firstPage.left": {
      "overflow": "drop-tail",
      "sections": [
        "photo",
        "contact",
        "languages",
        "expertise"
      ]
    },
    "firstPage.right": {
      "overflow": "drop-tail",
      "sections": [
        "header",
        "profile",
        "certifications"
      ]
    },
    "otherPages.main": {
      "overflow": "paginate",
      "sections": [
        "education",
        "experience",
        "publications",
        "interventions",
        "engagements"
      ]
    }
  }
}
